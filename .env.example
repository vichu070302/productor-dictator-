# Server Configuration
PORT=5000
NODE_ENV=development

# Optional External API Keys for Live Production Extensions
# Google Places API Key for live place search
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Agmarknet / APMC Market Data API Key
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# Vision AI API Key (OpenAI GPT-4 Vision / Gemini Vision)
VISION_AI_API_KEY=your_openai_or_gemini_api_key_here
